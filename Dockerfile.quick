# 快速部署Dockerfile
FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY . .

# 创建模型目录
RUN mkdir -p model recordings logs

# 下载模型文件
RUN wget -O model/yoloe-11l-seg.pt https://github.com/ultralytics/assets/releases/download/v0.0.0/yoloe-11l-seg.pt || true
RUN wget -O model/yolo-seg.pt https://github.com/ultralytics/assets/releases/download/v0.0.0/yolo-seg.pt || true
RUN wget -O model/trafficlight.pt https://github.com/ultralytics/assets/releases/download/v0.0.0/trafficlight.pt || true

# 创建非root用户
RUN useradd -m -u 1000 aiglass && chown -R aiglass:aiglass /app
USER aiglass

# 暴露端口
EXPOSE 8081

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8081/api/status || exit 1

# 启动命令
CMD ["python", "app_main.py"]
